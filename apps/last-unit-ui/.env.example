# LastUnit UI — local env template.
# Copy to .env.local (gitignored) and fill in the values:  cp .env.example .env.local
# Working values for this machine already exist in .env.local — this file documents them.

# --- chain (safe to commit, baked into the client bundle at build time) ---
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed LastUnit contract (v2, redemption + soulbound)
NEXT_PUBLIC_CONTRACT=0x0675a899e19Fe66D99dAD97e76763A49B8aa3A74
# Previous claim-only deployment, kept for reference/rollback
NEXT_PUBLIC_CONTRACT_FALLBACK=0xC127CaD099Db7ea41de666eB86619e035eA254cA

# Origin the QR codes point phones at. MUST be your machine's LAN IP (not localhost)
# if a phone is going to scan — find it with:  ipconfig getifaddr en0
NEXT_PUBLIC_BASE_URL=http://192.168.0.10:3000

# Which drop/checkpoint the pages default to (override per-page with ?drop=N)
NEXT_PUBLIC_ACTIVE_DROP=1
NEXT_PUBLIC_CHECKPOINT=1

# --- server-side keys (NEVER commit real values; 0x + 64 hex each) ---

# Signs QR challenges. Must match the beacon registered on-chain via setCheckpoint
# for the checkpoint above — a different key makes every claim revert BadBeaconSig.
BEACON_PK=0x...

# Relayer pool: comma-separated keys, one lane per account, claims go out round-robin.
# Every lane pays gas (~0.03 MON/claim) and must be funded: https://faucet.monad.xyz
# A single key works but collapses ordering to server arrival order — fine for UI
# work, wrong for demonstrating the race.
RELAYER_PKS=0x...,0x...,0x...

# Fallback used only when RELAYER_PKS is unset.
RELAYER_PK=0x...

# Registered on-chain via setCashier; pays gas for every redemption. Must be funded.
CASHIER_PK=0x...
